<article class="post-card">
  {% if post.data.featuredImage %}
  <a href="{{ post.url }}" class="post-card-image-link" tabindex="-1" aria-hidden="true">
    <img src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt or post.data.title }}" loading="lazy" decoding="async">
  </a>
  {% endif %}
  <div class="post-card-content">
    <header>
      <h2 class="post-card-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      <time class="post-card-date" datetime="{{ post.date | isoDate }}">{{ post.date | ptDate }}</time>
    </header>
    {% if post.data.description %}
    <p class="post-card-excerpt">{{ post.data.description }}</p>
    {% endif %}
    <a href="{{ post.url }}" class="post-card-link">Ler mais →</a>
  </div>
</article>
